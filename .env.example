# Copied to .env by scripts/install.sh, which also fills the secrets.
# Keep .env: ENCRYPTION_KEY decrypts every credential AnythingMCP stores.
JWT_SECRET=
ENCRYPTION_KEY=

# First admin account, created by scripts/install.sh.
AMCP_ADMIN_EMAIL=
AMCP_ADMIN_PASSWORD=

# Billbee Order Management: fill these and re-run scripts/install.sh to install the connector.
BILLBEE_API_KEY=
BILLBEE_LOGIN_EMAIL=
BILLBEE_API_PASSWORD=

# Written by scripts/install.sh.
MCP_URL=
MCP_API_KEY=
